<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_smart_reequilibrer" model="ir.cron">
        <field name="name">MRP Smart Reservation: Daily Rebalancing</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="state">code</field>
        <field name="code">model._cron_smart_reequilibrer()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=1, minute=0, second=0)"/>
    </record>

</odoo>
